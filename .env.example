# CrowdStacks environment configuration
# Copy this file to `.env.local` and adjust values for your deployment.
# All variables are NEXT_PUBLIC_* because they are read in the browser.

# Which Stacks network the frontend talks to.
# One of: testnet | mainnet | devnet  (defaults to testnet when unset)
NEXT_PUBLIC_STACKS_NETWORK=testnet

# Address of the deployed `crowdfunding` contract on the selected network.
# Defaults to the current testnet deployment when unset.
NEXT_PUBLIC_CONTRACT_ADDRESS=ST1RVN5QPTET1RV9BJQX35JQWJFYG8YNHQEY5QN24
